<?xml version="1.0" encoding="utf-8"?>
<!-- Material 3 TV style: the focused card grows a little. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" />
        </set>
    </item>
    <item android:state_focused="true">
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.06" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.06" android:valueType="floatType" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:duration="160" android:propertyName="scaleX" android:valueTo="1.0" android:valueType="floatType" />
            <objectAnimator android:duration="160" android:propertyName="scaleY" android:valueTo="1.0" android:valueType="floatType" />
        </set>
    </item>
</selector>
