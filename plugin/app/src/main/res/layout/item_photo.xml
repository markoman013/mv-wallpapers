<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:stateListAnimator="@animator/photo_zoom">

    <com.mv.wallpapers.plugin.GlowFrame
        android:layout_width="match_parent"
        android:layout_height="118dp"
        android:padding="6dp">

        <ImageView
            android:id="@+id/photo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/image_bg"
            android:scaleType="centerCrop" />

        <!-- Edit multiple: marked or not (top left) -->
        <ImageView
            android:id="@+id/mark"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_gravity="top|start"
            android:layout_margin="6dp"
            android:src="@drawable/mark_off"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/check"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:src="@drawable/check_full" />

        <!-- Hidden by the Seasonal photos setting (its seasons are off): crossed-out season, in the checkbox spot. -->
        <ImageView
            android:id="@+id/seasonOff"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_margin="6dp"
            android:padding="2dp"
            android:src="@drawable/badge_season_off"
            android:visibility="gone" />

        <!-- Small badges left of the checkbox: also tagged into other collections / into a season. -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="22dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginRight="26dp"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/badgeFolder"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="4dp"
                android:background="@drawable/badge_folder_bg"
                android:padding="3.5dp"
                android:src="@drawable/ic_chip_folder"
                android:tint="?attr/mvOnTonal"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/badgeTag"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="4dp"
                android:background="@drawable/badge_tag_bg"
                android:padding="3.5dp"
                android:src="@drawable/ic_chip_tag"
                android:tint="@color/chip_on_tag"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/badgeSeason"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="4dp"
                android:background="@drawable/badge_season_bg"
                android:padding="3.5dp"
                android:src="@drawable/ic_chip_season"
                android:tint="@color/chip_on_season"
                android:visibility="gone" />
        </LinearLayout>


    </com.mv.wallpapers.plugin.GlowFrame>
</FrameLayout>
