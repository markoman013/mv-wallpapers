<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingLeft="32dp"
    android:paddingRight="32dp"
    android:paddingTop="27dp"
    android:paddingBottom="8dp">

    <!-- Top bar: app, tabs (with icons), update when available. -->
    <com.mv.wallpapers.plugin.FocusRow
        android:id="@+id/topBar"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Left and right get equal width, so the tabs stay exactly centred
             whatever appears on either side (collection name, Update button). -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@mipmap/ic_launcher" />

            <TextView
                android:id="@+id/collectionName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="14dp"
                android:singleLine="true"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal">

            <Button
                android:id="@+id/tabCollections"
                style="@style/MVTab"
                android:drawableLeft="@drawable/ic_tab_collections"
                android:text="Collections" />

            <Button
                android:id="@+id/settings"
                style="@style/MVTab"
                android:drawableLeft="@drawable/ic_tab_settings"
                android:text="Settings" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:gravity="end|center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/update"
                style="@style/MVPill"
                android:layout_marginRight="12dp"
                android:drawableLeft="@drawable/ic_download_small"
                android:visibility="gone" />

            <TextView
                android:id="@+id/title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text_secondary"
                android:textSize="13sp" />
        </LinearLayout>
    </com.mv.wallpapers.plugin.FocusRow>

    <!-- Collections / Seasons content -->
    <LinearLayout
        android:id="@+id/collectionsPage"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Filters with the totals next to them. -->
        <com.mv.wallpapers.plugin.FocusRow
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/select"
                style="@style/MVPill"
                android:layout_marginLeft="0dp"
                android:drawableLeft="@drawable/ic_pill_checks"
                android:text="Select: all" />

            <Button
                android:id="@+id/view"
                style="@style/MVPill"
                android:drawableLeft="@drawable/ic_pill_eye"
                android:text="Show: all" />

            <Button
                android:id="@+id/sort"
                style="@style/MVPill"
                android:drawableLeft="@drawable/ic_pill_sort"
                android:text="Sort: name" />

            <Button
                android:id="@+id/slideshow"
                style="@style/MVPill"
                android:drawableLeft="@drawable/ic_pill_play"
                android:text="Slideshow" />

            <!-- Edit multiple: these replace the buttons above while marking. -->
            <Button
                android:id="@+id/bulkDone"
                style="@style/MVPill"
                android:layout_marginLeft="0dp"
                android:drawableLeft="@drawable/ic_pill_close"
                android:text="Done"
                android:visibility="gone" />

            <Button
                android:id="@+id/bulkMark"
                style="@style/MVPill"
                android:drawableLeft="@drawable/ic_pill_checks"
                android:text="Mark all"
                android:visibility="gone" />

            <Button
                android:id="@+id/bulkActions"
                style="@style/MVPill"
                android:drawableLeft="@drawable/ic_pill_more"
                android:text="Edit marked"
                android:visibility="gone" />

            <TextView
                android:id="@+id/total"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginLeft="18dp"
                android:layout_weight="1"
                android:singleLine="true"
                android:textColor="@color/text_secondary"
                android:textSize="14sp" />
        </com.mv.wallpapers.plugin.FocusRow>

        <!-- Negative side margins: the grid's own padding (room for the zoom) sits
             outside the content edges, so cards line up with the icon and buttons. -->


        <!-- Photos scroll behind the info bar, which floats at the bottom. -->
        <FrameLayout
            android:id="@+id/photoArea"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipChildren="false"
            android:clipToPadding="false">

            <com.mv.wallpapers.plugin.FocusGridView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="-18dp"
                android:layout_marginRight="-32dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:drawSelectorOnTop="false"
                android:horizontalSpacing="14dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="5"
                android:paddingLeft="12dp"
                android:paddingTop="14dp"
                android:paddingRight="26dp"
                android:paddingBottom="76dp"
                android:scrollbars="none"
                android:stretchMode="columnWidth"
                android:verticalSpacing="18dp" />

    <com.mv.wallpapers.plugin.FocusGridView
                android:id="@+id/photoGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginLeft="-18dp"
                android:layout_marginRight="-32dp"
                android:layout_marginTop="6dp"
                android:clipToPadding="false"
                android:drawSelectorOnTop="false"
                android:horizontalSpacing="14dp"
                android:listSelector="@android:color/transparent"
                android:numColumns="5"
                android:paddingLeft="12dp"
                android:paddingTop="14dp"
                android:paddingRight="26dp"
                android:paddingBottom="76dp"
                android:scrollbarStyle="outsideOverlay"
                android:stretchMode="columnWidth"
                android:verticalSpacing="18dp"
                android:visibility="gone" />

            <com.mv.wallpapers.plugin.BlurBar
                android:id="@+id/photoBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:background="@drawable/bar_bg"
                android:gravity="bottom"
                android:orientation="horizontal"
                android:paddingLeft="14dp"
                android:paddingTop="10dp"
                android:paddingRight="16dp"
                android:paddingBottom="10dp"
                >

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/metaCheck"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginRight="10dp"
                        android:visibility="invisible" />

                    <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/meta"
                        style="@style/MVMetaLine"
                        android:layout_marginBottom="3dp" />

                    <TextView
                        android:id="@+id/meta2"
                        style="@style/MVMetaLine" />
                </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="16dp"
                    android:paddingBottom="1dp"
                    android:id="@+id/barHint"
                    android:text="OK: open · Hold OK: options"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp" />
            </com.mv.wallpapers.plugin.BlurBar>
        </FrameLayout>

    </LinearLayout>

    <include layout="@layout/settings_page" />
</LinearLayout>
